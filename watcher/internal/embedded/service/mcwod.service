[Unit]
Description=Minecraft Wake-on-Demand Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=MCWOD_USER
Group=MCWOD_USER
ExecStart=/opt/mcwod/mcwod run
Environment=MCWOD_CONFIG=/opt/mcwod/config.yml
Environment=SERVER_SSH_KNOWN_HOSTS=/opt/mcwod/known_hosts
Restart=always
RestartSec=5

# Lets the watcher open an ICMP socket without running as root.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# The SSH key lives in the user's home, known_hosts is kept next to the binary.
ProtectHome=read-only
ReadWritePaths=/opt/mcwod
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
