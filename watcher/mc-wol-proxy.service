[Unit]
Description=Minecraft Wake-on-Demand Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/mc-wol-proxy/mc_wol_proxy.py
Environment=MC_WOL_CONFIG=/opt/mc-wol-proxy/config.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
